{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "lc3",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "line"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "\n"
              },
              {
                "type": "STRING",
                "value": "\u0000"
              }
            ]
          }
        ]
      }
    },
    "comment": {
      "type": "PATTERN",
      "value": ";[^\\n]*"
    },
    "line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "label_definition"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "label_definition"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "trap_alias"
                },
                {
                  "type": "SYMBOL",
                  "name": "instruction"
                },
                {
                  "type": "SYMBOL",
                  "name": "directive"
                }
              ]
            }
          ]
        }
      ]
    },
    "label_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "label"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "colon"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "mnemonic"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "operand"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "CHOICE",
                        "members": [
                          {
                            "type": "SYMBOL",
                            "name": "comma"
                          },
                          {
                            "type": "BLANK"
                          }
                        ]
                      },
                      {
                        "type": "SYMBOL",
                        "name": "operand"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "operand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "register"
        },
        {
          "type": "SYMBOL",
          "name": "integer"
        },
        {
          "type": "SYMBOL",
          "name": "label"
        }
      ]
    },
    "directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "period"
        },
        {
          "type": "SYMBOL",
          "name": "directive_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "integer"
              },
              {
                "type": "SYMBOL",
                "name": "string"
              }
            ]
          }
        }
      ]
    },
    "mnemonic": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "add"
        },
        {
          "type": "STRING",
          "value": "and"
        },
        {
          "type": "STRING",
          "value": "not"
        },
        {
          "type": "STRING",
          "value": "jmp"
        },
        {
          "type": "STRING",
          "value": "ret"
        },
        {
          "type": "STRING",
          "value": "jsr"
        },
        {
          "type": "STRING",
          "value": "jsrr"
        },
        {
          "type": "STRING",
          "value": "lea"
        },
        {
          "type": "STRING",
          "value": "ld"
        },
        {
          "type": "STRING",
          "value": "st"
        },
        {
          "type": "STRING",
          "value": "ldi"
        },
        {
          "type": "STRING",
          "value": "sti"
        },
        {
          "type": "STRING",
          "value": "ldr"
        },
        {
          "type": "STRING",
          "value": "str"
        },
        {
          "type": "STRING",
          "value": "br"
        },
        {
          "type": "STRING",
          "value": "brn"
        },
        {
          "type": "STRING",
          "value": "brz"
        },
        {
          "type": "STRING",
          "value": "brp"
        },
        {
          "type": "STRING",
          "value": "brnz"
        },
        {
          "type": "STRING",
          "value": "brzp"
        },
        {
          "type": "STRING",
          "value": "brnp"
        },
        {
          "type": "STRING",
          "value": "brnzp"
        },
        {
          "type": "STRING",
          "value": "trap"
        },
        {
          "type": "STRING",
          "value": "rti"
        }
      ]
    },
    "label": {
      "type": "PATTERN",
      "value": "[A-Z_][a-z0-9_]*"
    },
    "trap_alias": {
      "type": "PATTERN",
      "value": "[a-z_][a-z0-9_]*"
    },
    "directive_name": {
      "type": "PATTERN",
      "value": "[A-Z_]+"
    },
    "register": {
      "type": "PATTERN",
      "value": "r[0-7]"
    },
    "integer": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[-+]?0?x[-+]?[0-9a-zA-Z_]+"
        },
        {
          "type": "PATTERN",
          "value": "#?[-+]?[0-9_]+"
        },
        {
          "type": "PATTERN",
          "value": "'.+'"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "\".*\""
    },
    "period": {
      "type": "STRING",
      "value": "."
    },
    "comma": {
      "type": "STRING",
      "value": ","
    },
    "colon": {
      "type": "STRING",
      "value": ":"
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\r"
    },
    {
      "type": "STRING",
      "value": " "
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}