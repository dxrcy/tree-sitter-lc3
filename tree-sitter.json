{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "lc3",
            "camelcase": "Lc3",
            "title": "LC-3",
            "scope": "source.lc3",
            "file-types": [
                "asm",
                "s",
                "S",
                "lc3"
            ],
            "injection-regex": "^lc3$",
            "class-name": "TreeSitterLc3",
            "highlights": "queries/highlights.scm"
        }
    ],
    "metadata": {
        "version": "0.1.0",
        "license": "GPL-3",
        "description": "LC-3 grammar for tree-sitter",
        "authors": [
            {
                "name": "darcy"
            }
        ],
        "links": {
            "repository": "https://codeberg.org/dxrcy/tree-sitter-lc3"
        }
    }
}
